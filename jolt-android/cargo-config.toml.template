# Copy this file to .cargo/config.toml in the repository root
# Adjust the linker names to match your Android NDK version and desired API level

[target.aarch64-linux-android]
ar = "aarch64-linux-android-ar"
linker = "aarch64-linux-android30-clang"

[target.armv7-linux-androideabi]
ar = "arm-linux-androideabi-ar"
linker = "armv7a-linux-androideabi30-clang"

[target.i686-linux-android]
ar = "i686-linux-android-ar"
linker = "i686-linux-android30-clang"

[target.x86_64-linux-android]
ar = "x86_64-linux-android-ar"
linker = "x86_64-linux-android30-clang"

# The number in the linker name (e.g., 30 in android30-clang) specifies
# the minimum Android API level. Common values:
#
# API 21 (android21): Android 5.0 Lollipop - minimum for 64-bit support
# API 23 (android23): Android 6.0 Marshmallow
# API 26 (android26): Android 8.0 Oreo
# API 29 (android29): Android 10
# API 30 (android30): Android 11
# API 33 (android33): Android 13
#
# Choose based on your minimum supported Android version.

